typeset -g _zsh_theme_name=${(U)${THEME_PALETTE:-catppuccin-mocha}//-/_}
typeset -g _zsh_theme_variable="_ZSH_THEME_${_zsh_theme_name}"
typeset -g _zsh_theme_key="${_zsh_theme_variable}[muted]"
typeset -gx ZSH_THEME_MUTED=${(P)_zsh_theme_key}
_zsh_theme_key="${_zsh_theme_variable}[visual_background]"
typeset -gx ZSH_THEME_VISUAL_BACKGROUND=${(P)_zsh_theme_key}
_zsh_theme_key="${_zsh_theme_variable}[visual_foreground]"
typeset -gx ZSH_THEME_VISUAL_FOREGROUND=${(P)_zsh_theme_key}
_zsh_theme_key="${_zsh_theme_variable}[motion_dim_style]"
typeset -gx ZSH_THEME_MOTION_DIM_STYLE=${(P)_zsh_theme_key}
_zsh_theme_key="${_zsh_theme_variable}[motion_label_style]"
typeset -gx ZSH_THEME_MOTION_LABEL_STYLE=${(P)_zsh_theme_key}

unset _zsh_theme_name _zsh_theme_variable _zsh_theme_key
